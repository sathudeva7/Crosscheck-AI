# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never hold a real value.

# --- required ----------------------------------------------------------------

# platform.openai.com -> API keys. Used for transcription, extraction and the
# plain-language explanations.
OPENAI_API_KEY=

# Local Postgres, or a Supabase connection string.
#
# Deploying: use Supabase's *session pooler* string, not the direct one. The
# direct host (db.<ref>.supabase.co) resolves to IPv6 only, and most hosts are
# IPv4 only — the app starts, then every query times out with a connection
# error that looks nothing like an addressing problem.
#
# Supabase dashboard -> Connect -> Session pooler. Replace the postgresql://
# prefix with postgresql+psycopg:// so SQLAlchemy uses psycopg 3.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/postgres

# --- authentication ----------------------------------------------------------
# Leave CLERK_ISSUER empty and every request resolves to a single demo account,
# which is how the API runs locally with no Clerk project. Set it and tokens are
# verified for real — see app/auth.py.
#
# Clerk dashboard -> API keys -> Show JWT public key -> Issuer.
CLERK_ISSUER=
# Origins allowed to present a token. Must match where the frontend is served.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# --- tracing -----------------------------------------------------------------
# Every model call, tool call and graph step, with timings and token counts.
# LangChain reads these itself — there is no tracing code in the app.
#
# Think before setting these anywhere but a development machine. Tracing
# uploads the content of every call, and in this app that content is
# prescriptions, patient names, diagnoses and lab values.
#
# smith.langchain.com -> Settings -> API Keys.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=crosscheck

# Structure without the text. The trace tree, timings and token counts still
# arrive; prompts and answers stay local. The right setting for any records
# that are not the developer's own.
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# --- optional ----------------------------------------------------------------
# Browser origins allowed to call the API. Deployed, this must list the exact
# frontend origin — scheme and host, no trailing slash. A mismatch shows up in
# the browser as a failed fetch with no status code, which reads as the API
# being down rather than as a configuration error.
# CORS_ORIGINS=https://crosscheck.vercel.app

# Web lookup, used by one tool only: putting an interaction the drug database
# has already flagged into plain words. Without a key that tool is not offered
# and answers come from the record alone. It can never establish that an
# interaction exists — only the record does that.
# TAVILY_API_KEY=tvly-...

# --- object storage ----------------------------------------------------------
# Where uploaded documents go. Set these and originals live in Supabase Storage
# and survive a redeploy; leave them unset and they are written to UPLOAD_DIR on
# the local disk, which is right for development and wrong on a host — a
# container filesystem is wiped on every deploy, and the timeline goes on citing
# page 1 of a document nobody can open again.
#
# The bucket is created on first boot, private. Documents are served through
# short-lived signed links after this API has checked who is asking, so nothing
# is readable by URL alone.
#
# SUPABASE_SERVICE_KEY is the service_role key from Settings → API. It bypasses
# every access rule in the project: server only, never a VITE_ name.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...
# SUPABASE_BUCKET=documents
# SIGNED_URL_TTL=300

# Where uploaded documents are written when Supabase is not configured. Set by
# the Dockerfile to /data/uploads so a mounted volume can keep them; without a
# volume they are lost on every restart.
# UPLOAD_DIR=/data/uploads

# How to read a date whose order is ambiguous: 04-07-2019 is 4 July under DMY
# and 7 April under MDY.
# DATE_ORDER=DMY

# Set to 0 to run ingestion with no network and no drug identification.
# ENABLE_DRUG_LOOKUP=1
