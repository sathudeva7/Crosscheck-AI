# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real key here.

# Clerk dashboard -> API keys -> Publishable key.
# Safe to ship to the browser: it identifies your Clerk app, it does not grant
# anything. The secret key is the backend's, and never belongs in this file.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Where the FastAPI app is listening. Leave commented for local work.
# VITE_API_BASE_URL=http://localhost:8000
